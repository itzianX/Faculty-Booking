<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#0c0e17">
    <title>
        <%= mode==='signup' ? 'Create Account' : mode==='setup-admin' ? 'Set Up Administrator' : mode==='login'
            ? 'Sign In' : mode==='forgot' ? 'Forgot Password' : mode==='reset-form' ? 'Choose a New Password'
            : mode==='change-password' ? 'Change Password' : 'Account' %> | Anubis Core Registry
    </title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body data-theme="amethyst">
    <header>
        <div class="header-content">
            <div>
                <span class="header-brand-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 10 6 2l6 5h2l5-5-2 9c1 3 0 6-2 8l-3 3-3-3c-2-2-3-5-1-9z"/><path d="M9 13h2m2 0h2m-4 4 1 1 1-1"/></svg></span>
                <h1>Anubis Core Registry</h1>
                <p>Sign in to manage your faculty bookings</p>
            </div>
            <div class="header-label">ACCOUNT</div>
            <%- include('sidebar-toggle-button') %>
        </div>
    </header>
    <nav><a href="/">Home</a><a href="/login" class="<%= mode === 'login' ? 'active' : '' %>">Sign In</a><a
            href="/signup" class="<%= mode === 'signup' ? 'active' : '' %>">Create Account</a><% if (locals.currentUser) { %><a
            href="/account/password" class="<%= mode === 'change-password' ? 'active' : '' %>">Change Password</a><% } %></nav>
    <main class="page-container auth-page">
        <section class="container auth-card">
            <% if (mode==='error' ) { %>
                <div class="auth-message">
                    <h2>Account notice</h2>
                    <p>
                        <%= error %>
                    </p><a class="secondary-button" href="/login">Sign in</a><a class="secondary-button"
                        href="/signup">Create account</a><a class="secondary-button"
                        href="/forgot-password">Forgot password</a>
                </div>
                <% } else if (mode==='signup' ) { %>
                    <div class="section-heading">
                        <div>
                            <h2>Create your account</h2>
                            <p>Your email will be used to track booking decisions.</p>
                        </div>
                    </div>
                    <form action="/signup" method="POST">
                        <label for="full_name">Full name</label><input id="full_name" name="full_name" maxlength="150"
                            autocomplete="name" required>
                        <label for="email">Email</label><input id="email" name="email" type="email" maxlength="150"
                            autocomplete="email" required>
                        <label for="password">Password</label>
                        <div class="password-field"><input id="password" name="password" type="password" minlength="10"
                                maxlength="200" autocomplete="new-password" required><button class="password-toggle"
                                type="button" aria-label="Show password" aria-pressed="false"><svg class="eye-open"
                                    viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z" />
                                    <circle cx="12" cy="12" r="3" />
                                </svg><svg class="eye-closed" viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="m3 3 18 18M10.6 10.6a2 2 0 0 0 2.8 2.8" />
                                    <path
                                        d="M9.9 5.2A10.8 10.8 0 0 1 12 5c6.4 0 10 7 10 7a14.8 14.8 0 0 1-3.1 3.8M6.2 6.2C3.5 8 2 12 2 12s3.6 7 10 7a10 10 0 0 0 4-.8" />
                                </svg></button></div>
                        <p class="form-note">Use at least 10 characters. Your password is stored as a one-way hash.</p>
                        <button class="submit-button" type="submit">Create Account</button>
                    </form>
                    <p class="auth-switch">Already registered? <a href="/login">Sign in</a>.</p>
                    <% } else if (mode==='setup-admin' ) { %>
                        <div class="section-heading">
                            <div>
                                <h2>Set up the administrator</h2>
                                <p>Create the first admin account for this system. This page is disabled after setup.
                                </p>
                            </div>
                        </div>
                        <form action="/setup-admin" method="POST">
                            <label for="full_name">Administrator name</label><input id="full_name" name="full_name"
                                maxlength="150" autocomplete="name" required>
                            <label for="email">Administrator email</label><input id="email" name="email" type="email"
                                maxlength="150" autocomplete="email" required>
                            <label for="password">Password</label>
                            <div class="password-field"><input id="password" name="password" type="password"
                                    minlength="10" maxlength="200" autocomplete="new-password" required><button
                                    class="password-toggle" type="button" aria-label="Show password"
                                    aria-pressed="false"><svg class="eye-open" viewBox="0 0 24 24" aria-hidden="true">
                                        <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z" />
                                        <circle cx="12" cy="12" r="3" />
                                    </svg><svg class="eye-closed" viewBox="0 0 24 24" aria-hidden="true">
                                        <path d="m3 3 18 18M10.6 10.6a2 2 0 0 0 2.8 2.8" />
                                        <path
                                            d="M9.9 5.2A10.8 10.8 0 0 1 12 5c6.4 0 10 7 10 7a14.8 14.8 0 0 1-3.1 3.8M6.2 6.2C3.5 8 2 12 2 12s3.6 7 10 7a10 10 0 0 0 4-.8" />
                                    </svg></button></div>
                            <p class="form-note">Use at least 10 characters. The password is stored as a one-way hash.
                            </p>
                            <button class="submit-button" type="submit">Create Administrator</button>
                        </form>
                        <% } else if (mode==='forgot') { %>
                            <div class="section-heading">
                                <div>
                                    <h2>Forgot your password?</h2>
                                    <p>Enter your account email and we'll send you a link to choose a new password.</p>
                                </div>
                            </div>
                            <% if (locals.notice) { %><p class="form-note" role="status"><%= notice %></p><% } %>
                            <% if (!locals.sent) { %>
                            <form action="/forgot-password" method="POST">
                                <label for="email">Email</label>
                                <input id="email" name="email" type="email" maxlength="150" autocomplete="email" required>
                                <button class="submit-button" type="submit">Send Reset Link</button>
                            </form>
                            <% } %>
                            <p class="auth-switch"><a href="/login">Back to sign in</a></p>
                        <% } else if (mode==='reset-form') { %>
                            <div class="section-heading">
                                <div>
                                    <h2>Choose a new password</h2>
                                    <p>Enter a new password for your account.</p>
                                </div>
                            </div>
                            <% if (locals.error) { %><p class="form-note" role="alert"><%= error %></p><% } %>
                            <form action="/reset-password/<%= token %>" method="POST">
                                <label for="password">New password</label>
                                <%- include('password-field', { id: 'password', name: 'password', autocomplete: 'new-password', minlength: 10 }) %>
                                <label for="confirm_password">Confirm new password</label>
                                <%- include('password-field', { id: 'confirm_password', name: 'confirm_password', autocomplete: 'new-password', minlength: 10 }) %>
                                <p class="form-note">Use at least 10 characters.</p>
                                <button class="submit-button" type="submit">Update Password</button>
                            </form>
                        <% } else if (mode==='change-password') { %>
                            <div class="section-heading">
                                <div>
                                    <h2>Change your password</h2>
                                    <p>Enter your current password, then choose a new one.</p>
                                </div>
                            </div>
                            <% if (locals.error) { %><p class="form-note" role="alert"><%= error %></p><% } %>
                            <% if (locals.notice) { %><p class="form-note" role="status"><%= notice %></p><% } %>
                            <form action="/account/password" method="POST">
                                <label for="current_password">Current password</label>
                                <%- include('password-field', { id: 'current_password', name: 'current_password', autocomplete: 'current-password', minlength: 0 }) %>
                                <label for="password">New password</label>
                                <%- include('password-field', { id: 'password', name: 'password', autocomplete: 'new-password', minlength: 10 }) %>
                                <label for="confirm_password">Confirm new password</label>
                                <%- include('password-field', { id: 'confirm_password', name: 'confirm_password', autocomplete: 'new-password', minlength: 10 }) %>
                                <p class="form-note">Use at least 10 characters.</p>
                                <button class="submit-button" type="submit">Change Password</button>
                            </form>
                        <% } else if (mode==='reset-password') { %>
                            <div class="section-heading">
                                <div>
                                    <h2>Reset a user's password</h2>
                                    <p>Enter the user's email and a temporary password.</p>
                                </div>
                            </div>
                            <% if (locals.notice) { %><p class="form-note"><%= notice %></p><% } %>
                            <form action="/admin/reset-password" method="POST">
                                <label for="email">User email</label>
                                <input id="email" name="email" type="email" maxlength="150" required>
                                <label for="password">Temporary password</label>
                                <input id="password" name="password" type="text" minlength="10" maxlength="200" autocomplete="off" required>
                                <p class="form-note">Use at least 10 characters.</p>
                                <button class="submit-button" type="submit">Reset Password</button>
                            </form>
                        <% } else { %>
                            <div class="section-heading">
                                <div>
                                    <h2>Welcome back</h2>
                                    <p>Sign in to submit a booking or check its status.</p>
                                </div>
                            </div>
                            <% if (locals.notice) { %><p class="form-note" role="status"><%= notice %></p><% } %>
                            <div class="login-options" role="group" aria-label="Choose account type">
                                <button type="button" class="login-option selected" data-login-type="user"
                                    aria-pressed="true">
                                    <strong>User Sign In</strong><span>Submit and track bookings</span>
                                </button>
                                <button type="button" class="login-option" data-login-type="admin" aria-pressed="false">
                                    <strong>Admin Sign In</strong><span>Review and manage requests</span>
                                </button>
                            </div>
                            <form action="/login" method="POST">
                                <input type="hidden" id="login_type" name="login_type" value="user">
                                <label id="login-identifier-label" for="login-identifier">Email</label><input id="login-identifier" name="identifier" type="text"
                                    autocomplete="username" placeholder="Enter your email" required>
                                <label for="password">Password</label>
                                <div class="password-field"><input id="password" name="password" type="password"
                                        autocomplete="current-password" required><button class="password-toggle"
                                        type="button" aria-label="Show password" aria-pressed="false"><svg
                                            class="eye-open" viewBox="0 0 24 24" aria-hidden="true">
                                            <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z" />
                                            <circle cx="12" cy="12" r="3" />
                                        </svg><svg class="eye-closed" viewBox="0 0 24 24" aria-hidden="true">
                                            <path d="m3 3 18 18M10.6 10.6a2 2 0 0 0 2.8 2.8" />
                                            <path
                                                d="M9.9 5.2A10.8 10.8 0 0 1 12 5c6.4 0 10 7 10 7a14.8 14.8 0 0 1-3.1 3.8M6.2 6.2C3.5 8 2 12 2 12s3.6 7 10 7a10 10 0 0 0 4-.8" />
                                        </svg></button></div>
                                <button class="submit-button" type="submit" id="login-submit">Sign In as User</button>
                            </form>
                            <p class="auth-switch">New here? <a href="/signup">Create an account</a> &nbsp;|&nbsp; <a href="/forgot-password">Forgot password?</a></p>
                            <% } %>
        </section>
    </main>
    <footer>
        <p>Anubis Core Registry &copy; 2026</p>
        <p>Organized bookings for faculty events</p>
    </footer>
    <script>
        document.querySelectorAll('.password-toggle').forEach((button) => {
            button.addEventListener('click', () => {
                const input = button.parentElement.querySelector('input');
                const showPassword = input.type === 'password';
                input.type = showPassword ? 'text' : 'password';
                button.classList.toggle('is-visible', showPassword);
                button.setAttribute('aria-label', showPassword ? 'Hide password' : 'Show password');
                button.setAttribute('aria-pressed', String(showPassword));
            });
        });
        const loginType = document.getElementById('login_type');
        if (loginType) {
            const options = document.querySelectorAll('.login-option');
            const submit = document.getElementById('login-submit');
            const identifierLabel = document.getElementById('login-identifier-label');
            const identifierInput = document.getElementById('login-identifier');
            const adminHint = document.getElementById('admin-test-hint');
            options.forEach((option) => {
                option.addEventListener('click', () => {
                    loginType.value = option.dataset.loginType;
                    options.forEach((item) => {
                        const selected = item === option;
                        item.classList.toggle('selected', selected);
                        item.setAttribute('aria-pressed', String(selected));
                    });
                    const isAdmin = option.dataset.loginType === 'admin';
                    submit.textContent = isAdmin ? 'Sign In as Admin' : 'Sign In as User';
                    identifierLabel.textContent = isAdmin ? 'Username or email' : 'Email';
                    identifierInput.placeholder = isAdmin ? 'Enter admin' : 'Enter your email';
                    if (adminHint) adminHint.hidden = !isAdmin;
                });
            });
        }
    </script>
    <script src="/js/sidebar-toggle.js" defer></script>
</body>

</html>
